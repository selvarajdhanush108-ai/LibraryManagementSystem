# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration (SQL Server for .NET 10 / SQLite for containerized preview)
ConnectionStrings__DefaultConnection="Server=localhost,1433;Database=KsrLibraryDb;User Id=sa;Password=CHANGE_ME_STRONG_PASSWORD;TrustServerCertificate=True;"
DATABASE_FILE="./database/ksr_library.db"

# JWT & Authentication Configuration
JWT_SECRET="REPLACE_WITH_AT_LEAST_32_CHAR_CRYPTOGRAPHIC_SECRET"
JWT_ISSUER="KsrCollegeLibraryAPI"
JWT_AUDIENCE="KsrCollegeLibraryClient"
ACCESS_TOKEN_EXPIRY_MINUTES="60"
REFRESH_TOKEN_EXPIRY_DAYS="7"

# Development Seeding (Set to true only in local/development environments)
ENABLE_DEMO_SEED="true"
DEMO_ADMIN_EMAIL="admin@ksrce.ac.in"

